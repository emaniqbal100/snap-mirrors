{
    "name": "snap-mirror-backend",
    "version": "1.0.0",
    "description": "Snap's Mirror - Backend API",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch -r dotenv/config src/index.ts dotenv_config_path=../.env",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "jest",
        "migrate": "tsx src/scripts/migrate.ts",
        "seed": "tsx src/scripts/seed.ts",
        "seed:admin": "tsx src/scripts/seedAdmin.ts"
    },
    "keywords": [
        "backend",
        "api",
        "express",
        "postgresql"
    ],
    "author": "Snap Mirror Team",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.7.4",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^1.41.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.1.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.0",
        "multer": "^2.2.0",
        "multer-storage-cloudinary": "^4.0.0",
        "nodemailer": "^6.9.13",
        "pg": "^8.22.0",
        "pg-pool": "^3.6.1",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.10.6",
        "@types/nodemailer": "^6.4.14",
        "@types/pg": "^8.20.4",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.10",
        "typescript": "^5.3.3"
    }
}
